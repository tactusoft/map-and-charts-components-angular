{
  "name": "map-and-charts-components-angular-sample",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "buildComponent": "ng build --configuration=production --output-hashing none && node build-component.js prod",
    "buildComponent:dev": "ng build --configuration=development --output-hashing none && node build-component.js dev",
    "buildComponent:test": "ng build --configuration=test --output-hashing none && node build-component.js test",
    "buildComponentWin": "ng build --configuration=production --output-hashing none & node build-component.js"
  },
  "dependencies": {
    "@angular/animations": "~20.3.3",
    "@angular/common": "~20.3.3",
    "@angular/compiler": "~20.3.3",
    "@angular/core": "~20.3.3",
    "@angular/elements": "~20.3.3",
    "@angular/forms": "~20.3.3",
    "@angular/platform-browser": "~20.3.3",
    "@angular/platform-browser-dynamic": "~20.3.3",
    "@angular/router": "~20.3.3",
    "@arcgis/charts-components": "~4.34.0",
    "@arcgis/core": "~4.34.0",
    "@arcgis/map-components": "~4.34.0",
    "@esri/calcite-components": "^3.3.2",
    "@tmcw/togeojson": "^5.8.1",
    "@ungap/custom-elements": "^1.2.0",
    "chart.js": "4.4.7",
    "chartjs-plugin-datalabels": "^2.2.0",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "type-fest": "^4.18.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.1",
    "@angular/cli": "~20.3.3",
    "@angular/compiler-cli": "~20.3.3",
    "@types/jasmine": "~5.1.6",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.3"
  }
}
